# Secrets (jamais versionnés)
.env

# Environnements virtuels / cache Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Couverture de tests (pytest-cov) — artefact régénérable, jamais versionné
.coverage
.coverage.*
htmlcov/
coverage.xml

# Temporaires Hermes
.hermes-tmp*/

# Logs (diagnostic local uniquement)
logs/

# États éphémères (cooldowns, marqueurs de déjà-vu — régénérables)
data/alerts_state.json
data/spec_candidates_state.json
data/news_state.json
data/boc_state.json
data/value_state.json
data/portf_alert_state.json
# Vérification des titres dormants — réécrite à chaque refresh (le commentaire doit être
# sur sa PROPRE ligne : gitignore ne connaît pas les commentaires en fin de ligne)
data/titres_inactifs.json

# Volumineux / régénérable via scripts/refresh_history.py (~7 Mo chacun)
data/*.pkl
# Empreinte SHA-256 du cache préparé (régénérée avec lui par scripts/preparer_historique_propre.py)
data/*.pkl.sha256

# Pages HTML brutes téléchargées par les collecteurs — artefacts de diagnostic
# (data/snts_dividend.html reste versionné : page d'archive conservée comme source)
data/*.html

# Sauvegardes locales prises avant correction — jamais des données du système
data/*.bak-avant-*

# Dossiers de travail temporaires des collecteurs (téléchargements bruts : PDF d'états
# financiers, images) — 09/11/2026 : data/tmp_neic/ pesait 6,7 Mo et polluait git status.
# Le glob data/*.pdf ci-dessus ne couvre PAS les sous-dossiers, d'où cette règle dédiée.
data/tmp_*/

# Données personnelles et documents de recherche/notation — B2-15 (13/10/2026) :
# jamais versionnés (un dépôt qui fuit ne doit pas exposer les avis courtier ; le
# passage en public, un fork ou un bundle les exposeraient). Les fichiers restent
# SUR LE DISQUE (lus par scripts/parse_avis*.py) — seul le suivi git s'arrête.
data/avis/
data/*.pdf
data/*.png
data/*.txt
